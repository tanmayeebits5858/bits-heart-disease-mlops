{
  "title": "Heart Disease API",
  "uid": "heart-api",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by path and status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (path, status) (rate(api_requests_total[1m]))",
          "legendFormat": "{{path}} {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 latency",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(api_request_latency_seconds_bucket[5m])))",
          "legendFormat": "{{path}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Predictions by class",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (prediction) (model_predictions_total)",
          "legendFormat": "{{path}} {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Model loaded",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "model_loaded",
          "legendFormat": "{{path}} {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Error rate (4xx/5xx)",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "datasource": {
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(api_requests_total{status=~\"4..|5..\"}[5m]))",
          "legendFormat": "{{path}} {{status}}",
          "refId": "A"
        }
      ]
    }
  ]
}